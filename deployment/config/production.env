# Ansible Automation Platform - Production Configuration

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# Frontend Configuration
REACT_APP_BACKEND_URL=http://localhost:8000
NODE_ENV=production

# Data Directories
ANSIBLE_DATA_DIR=/var/lib/ansible-automation
ANSIBLE_LOG_DIR=/var/log/ansible-automation

# Security
GENERATE_SSH_KEYS_ON_STARTUP=true
DEFAULT_SSH_KEY_TYPE=rsa
DEFAULT_SSH_KEY_BITS=4096

# Ansible Configuration
ANSIBLE_HOST_KEY_CHECKING=False
ANSIBLE_RETRY_FILES_ENABLED=False
ANSIBLE_STDOUT_CALLBACK=yaml
ANSIBLE_LOG_PATH=/var/log/ansible-automation/ansible.log

# Application Settings
MAX_CONCURRENT_EXECUTIONS=5
EXECUTION_TIMEOUT=3600
KEEP_LOGS_DAYS=30