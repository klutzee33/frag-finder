[Unit]
Description=Ansible Automation Platform - Backend API
After=network.target
Wants=network.target

[Service]
Type=simple
User=ansible-user
Group=ansible-user
WorkingDirectory=/opt/ansible-automation/backend
Environment=PYTHONPATH=/opt/ansible-automation/backend
Environment=PATH=/opt/ansible-automation/backend/venv/bin
ExecStart=/opt/ansible-automation/backend/venv/bin/python -m uvicorn server:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ansible-automation-backend

# Security settings
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/ansible-automation /var/lib/ansible-automation /var/log/ansible-automation /tmp
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target